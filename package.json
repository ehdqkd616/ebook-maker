{
  "name": "ebook-maker",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @ebook/web",
    "build": "npm run build -w @ebook/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "db:up": "docker compose up -d"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
