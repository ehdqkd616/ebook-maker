# 서버 — pm2가 127.0.0.1:3400으로 띄우고 외부 접근은 Caddy를 통해서만 (ecosystem.config.cjs)
# DB 위치 (기본: apps/web/storage)
STORAGE_DIR=

# 회원·세션
SESSION_DAYS=7
# IP별 시간당 가입 신청 수
SIGNUP_LIMIT_PER_HOUR=10
# 가입 승인 시 지급하는 크레딧 (0이면 지급 안 함)
SIGNUP_CREDITS=500
# 공통 관리자 계정 admin의 비밀번호 — 서버가 시작할 때마다 이 값으로 만들거나 맞춘다(.env가 기준)
ADMIN_PASSWORD=

# 회원가입 승인 요청 메일 (관리자에게). Gmail은 2단계 인증 + 앱 비밀번호. 비워 두면 발송 안 함
PUBLIC_WEB_URL=http://localhost:3000
ADMIN_NOTIFY_EMAILS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
